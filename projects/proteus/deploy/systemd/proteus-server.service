[Unit]
Description=Proteus α-profile server
Documentation=https://github.com/Icarus603/network-from-scratch
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify — the binary sends sd_notify(READY=1) AFTER the
# listener is bound and the startup self-test has passed. Lets
# downstream services ordered `After=proteus-server.service`
# (e.g. a reverse proxy) start only when Proteus genuinely is
# ready, instead of racing a still-loading backend.
#
# `notify-reload` (systemd >= 253) would also let `systemctl
# reload` route through sd_notify; we stay on `notify` for now
# since the binary handles SIGHUP directly.
Type=notify
NotifyAccess=main

# Liveness watchdog. If no WATCHDOG=1 ping arrives within this
# window, systemd restarts the service. The binary pings at
# half the configured interval (per sd_notify(3) guidance), so
# 30s here means a ping every 15s — a deadlocked tokio runtime
# (lock contention, dropped-task-leak, ...) is auto-restarted
# within at most 30s, even though the process itself is alive.
# Without this, a deadlocked Proteus stays "active (running)"
# forever and operators only notice when users complain.
WatchdogSec=30s

User=proteus
Group=proteus

# Read keys + config from /etc/proteus.
ExecStart=/usr/local/bin/proteus-server run --config /etc/proteus/server.yaml
# `systemctl reload proteus-server` → SIGHUP → in-process reload
# of TLS cert + firewall rules + rate-limit values +
# user_quarantine state. The binary sends RELOADING=1 at SIGHUP
# entry and READY=1 + a fresh STATUS line at exit, so the
# reload outcome surfaces in `systemctl status` without
# scraping journalctl.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# TimeoutStopSec must be >= server.yaml `drain_secs` + a small
# margin so the binary can complete its drain (notify_stopping
# fires the moment SIGTERM arrives, so accounting starts here).
# Default drain_secs is 30s; bump this to 60s for a comfortable
# margin during graceful rolling restarts.
TimeoutStopSec=60s

# --- Security hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @cpu-emulation @obsolete

# Need TCP listen — give CAP_NET_BIND_SERVICE so we can use 443 as non-root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Read-only access to keys, read-write to logs + state dir.
# /var/lib/proteus is required when `restart_state_file:` is set
# in server.yaml (recommended for production — exposes the
# proteus_restarts_total + previous_run_unclean series so
# operators can detect crash loops). systemd auto-creates the
# StateDirectory= path with 0750 ownership.
ReadOnlyPaths=/etc/proteus
ReadWritePaths=/var/log/proteus
StateDirectory=proteus
StateDirectoryMode=0750

# Network exposure.
IPAddressAllow=any
SocketBindAllow=tcp:443
SocketBindAllow=tcp:8443

# Resource caps.
LimitNOFILE=1048576
LimitNPROC=4096

# Cgroup-level resource caps. Without these, a runaway memory
# leak or a DoS-induced task spawn can OOM the host (taking SSH
# down with it). With them, the kernel kills proteus-server
# specifically when it crosses the limit — and our restart-
# tracker observability (proteus_previous_run_unclean=1) makes
# the OOM-kill visible on the next start.
#
# MemoryHigh    — soft cap; kernel throttles allocations above
#                 this without killing. Gives the binary a chance
#                 to refuse new sessions / shed load gracefully
#                 before the hard cap triggers.
# MemoryMax     — hard cap; kernel kills the process when this
#                 is exceeded. 2× MemoryHigh leaves drain
#                 headroom but bounds the worst case.
# TasksMax      — kernel-cgroup tasks ceiling. LimitNPROC is the
#                 process-level rlimit; TasksMax is the
#                 belt-and-braces cgroup version. Both matter:
#                 LimitNPROC catches a fork bomb in the parent
#                 process, TasksMax catches it after a privilege
#                 boundary.
#
# Defaults assume a 1-2 GB VPS. For larger boxes, scale up
# proportionally. To override per-deploy:
#   sudo systemctl edit proteus-server
#   # in the drop-in: [Service] / MemoryMax=4G / TasksMax=16384
MemoryHigh=512M
MemoryMax=1G
TasksMax=8192

# OOM score adjustment. -100 lowers Proteus's score so the OOM
# killer prefers other processes first (within reason — the
# allowed range is -1000..1000). A long-lived proxy that's
# stayed under MemoryHigh shouldn't be the first thing killed
# when an unrelated process triggers system-wide OOM. Operators
# who'd rather kill Proteus first (e.g. on a multi-tenant box
# where the proxy is the lower-priority workload) can override
# via `systemctl edit`.
OOMScoreAdjust=-100

# Logging.
Environment=RUST_LOG=proteus_server=info,proteus_transport_alpha=info

# Iter-24 + iter-31: panic-handling policy.
#
# Default (no env var, what ships): panic = "unwind" in the
# release profile (see workspace Cargo.toml). tokio::spawn's
# task wrapper catches per-task panics; other tasks continue
# serving traffic; `proteus_panic_hook` increments the
# `proteus_panics_total` counter + emits a structured WARN
# log with file:line:col. Operators alert on
# `rate(proteus_panics_total[5m]) > 0` (the ProteusPanic
# alert in deploy/prometheus/proteus-alerts.yaml).
#
# OPT-IN to fail-fast: uncomment the line below to make
# panic_hook re-abort AFTER counting + logging. Use cases:
#   - Fuzzing harness — every panic should crash so AFL/
#     libFuzzer captures the input as a crash signal.
#   - Strict production policy where any panic is operator-
#     paging-grade and you'd rather restart-via-systemd
#     than serve one more request through a possibly-
#     poisoned-state process.
# Environment=RUST_PANIC_ABORT=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
