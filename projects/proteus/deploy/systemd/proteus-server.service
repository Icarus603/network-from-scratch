[Unit]
Description=Proteus α-profile server
Documentation=https://github.com/Icarus603/network-from-scratch
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify — the binary sends sd_notify(READY=1) AFTER the
# listener is bound and the startup self-test has passed. Lets
# downstream services ordered `After=proteus-server.service`
# (e.g. a reverse proxy) start only when Proteus genuinely is
# ready, instead of racing a still-loading backend.
#
# `notify-reload` (systemd >= 253) would also let `systemctl
# reload` route through sd_notify; we stay on `notify` for now
# since the binary handles SIGHUP directly.
Type=notify
NotifyAccess=main

# Liveness watchdog. If no WATCHDOG=1 ping arrives within this
# window, systemd restarts the service. The binary pings at
# half the configured interval (per sd_notify(3) guidance), so
# 30s here means a ping every 15s — a deadlocked tokio runtime
# (lock contention, dropped-task-leak, ...) is auto-restarted
# within at most 30s, even though the process itself is alive.
# Without this, a deadlocked Proteus stays "active (running)"
# forever and operators only notice when users complain.
WatchdogSec=30s

User=proteus
Group=proteus

# Read keys + config from /etc/proteus.
ExecStart=/usr/local/bin/proteus-server run --config /etc/proteus/server.yaml
# `systemctl reload proteus-server` → SIGHUP → in-process reload
# of TLS cert + firewall rules + rate-limit values +
# user_quarantine state. The binary sends RELOADING=1 at SIGHUP
# entry and READY=1 + a fresh STATUS line at exit, so the
# reload outcome surfaces in `systemctl status` without
# scraping journalctl.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# TimeoutStopSec must be >= server.yaml `drain_secs` + a small
# margin so the binary can complete its drain (notify_stopping
# fires the moment SIGTERM arrives, so accounting starts here).
# Default drain_secs is 30s; bump this to 60s for a comfortable
# margin during graceful rolling restarts.
TimeoutStopSec=60s

# --- Security hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @cpu-emulation @obsolete

# Need TCP listen — give CAP_NET_BIND_SERVICE so we can use 443 as non-root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Read-only access to keys, read-write to logs + state dir.
# /var/lib/proteus is required when `restart_state_file:` is set
# in server.yaml (recommended for production — exposes the
# proteus_restarts_total + previous_run_unclean series so
# operators can detect crash loops). systemd auto-creates the
# StateDirectory= path with 0750 ownership.
ReadOnlyPaths=/etc/proteus
ReadWritePaths=/var/log/proteus
StateDirectory=proteus
StateDirectoryMode=0750

# Network exposure.
IPAddressAllow=any
SocketBindAllow=tcp:443
SocketBindAllow=tcp:8443

# Resource caps.
LimitNOFILE=1048576
LimitNPROC=4096

# Logging.
Environment=RUST_LOG=proteus_server=info,proteus_transport_alpha=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
