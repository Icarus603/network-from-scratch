[Unit]
Description=Proteus α-profile client (SOCKS5 → Proteus tunnel)
Documentation=https://github.com/Icarus603/network-from-scratch
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify — the binary sends sd_notify(READY=1) AFTER the
# SOCKS5 listener is bound. Lets `After=proteus-client.service`
# downstream apps (a browser auto-proxy script, a containerized
# CLI tool) start only when the SOCKS5 surface is actually ready
# to accept CONNECTs.
Type=notify
NotifyAccess=main

# Liveness watchdog. Same rationale as proteus-server.service.
# A deadlocked tokio runtime in the client (lock contention in
# the multi-VPS endpoint pool, dropped-task-leak in the SOCKS5
# dispatch) → no WATCHDOG=1 ping → systemd restarts within at
# most WatchdogSec seconds. Without this, a wedged client looks
# identical to "the upstream server is unreachable" — operators
# can't distinguish a local bug from a network outage.
WatchdogSec=30s

# Run as a system service when using the bundled unit. Operators
# who'd rather run per-user via `systemctl --user` can copy this
# file to ~/.config/systemd/user/ and drop the User=/Group=
# lines; the rest of the directives are user-compatible.
User=proteus
Group=proteus

ExecStart=/usr/local/bin/proteus-client run --config /etc/proteus/client.yaml
# `systemctl reload proteus-client` → SIGHUP → in-process
# hot-reload of the multi-VPS endpoint pool from client.yaml.
# The binary doesn't currently emit RELOADING/READY around the
# client-side SIGHUP (the pool reload is a single atomic swap;
# adding sd_notify there is a one-line follow-up if operator
# demand emerges), but the kill -HUP path itself is in place.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# TimeoutStopSec must be >= client.yaml `drain_secs` (default
# 15s) + a small margin so the binary can complete its drain
# (notify_stopping fires the moment SIGTERM arrives, so
# accounting starts here).
TimeoutStopSec=30s

# --- Security hardening (identical to server side) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @cpu-emulation @obsolete

# Client doesn't bind privileged ports — SOCKS5 lives on
# 127.0.0.1:1080 by default (unprivileged). No CAP_NET_BIND_SERVICE
# is needed; the empty bounding set is the minimum-privilege
# default for a userspace SOCKS5 proxy.
CapabilityBoundingSet=
AmbientCapabilities=

# Read-only access to keys + config. No state-dir needed today
# (client has no persistent state files yet); add later as the
# client gains restart_state_file etc.
ReadOnlyPaths=/etc/proteus

# SOCKS5 listener bind constraint. Loopback by default; if the
# operator binds to a LAN address in client.yaml they must add
# a corresponding SocketBindAllow= rule via `systemctl edit`.
IPAddressAllow=localhost
SocketBindAllow=tcp:1080

# Resource caps. Lower defaults than the server — a client
# session is one SOCKS5 + one upstream Proteus pair, vs. the
# server's accept-and-relay-to-arbitrary-upstream pattern.
LimitNOFILE=65536
LimitNPROC=2048

# Cgroup-level caps. Same rationale as the server unit; the
# client's footprint is smaller so the defaults are tighter.
# An operator running multiple parallel SOCKS5 clients on the
# same box should scale via `systemctl edit`.
MemoryHigh=256M
MemoryMax=512M
TasksMax=4096
OOMScoreAdjust=-100

# Logging.
Environment=RUST_LOG=proteus_client=info,proteus_transport_alpha=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
